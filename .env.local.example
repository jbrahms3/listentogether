# Clerk account (https://dashboard.clerk.com) -- required to sign in and
# post chat messages. Create an application there (any sign-in method is
# fine) and copy its API keys from the dashboard's "API keys" page.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Spotify Developer app credentials (https://developer.spotify.com/dashboard)
# Create an app there, no redirect URI is needed since this uses the
# Client Credentials flow (read-only public metadata, no user login).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: seed track IDs for the room queue (comma separated Spotify track IDs).
# If left blank, the app seeds itself by searching Spotify for a small
# classical playlist on first boot.
SEED_TRACK_IDS=

# Optional: a YouTube Data API v3 key adds a YouTube link to "listen on your
# preferred service" (https://console.cloud.google.com/apis/library/youtube.googleapis.com
# -- create a project, enable the API, then create an API key; the free
# quota is generous for this app's traffic). Apple Music and Deezer links
# work automatically with no key needed. Leave blank to skip YouTube.
YOUTUBE_API_KEY=

# Optional: a Redis connection string makes the room queue, chat, and
# presence shared across multiple server instances instead of living in one
# process's memory -- needed if this app is ever scaled beyond a single
# instance. Leave blank for local development; an in-memory fallback is used
# automatically (see lib/store.ts). On Railway, add a Redis service to the
# project and reference its REDIS_URL from this service's variables.
REDIS_URL=
